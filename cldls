#!/bin/bash
set -euo pipefail

# Use the common manager when installed alongside it; retain standalone fallback.
managed_root=$(cd "$(dirname "$0")" && pwd)
if [ "${CLAI_STANDALONE:-0}" != 1 ] && [ -x "$managed_root/clai" ] && [ -f "$managed_root/providers.json" ]; then
  exec "$managed_root/clai" run local-deepseek -- "$@"
fi

resolve_claude() {
  local path
  if [ "${CLAI_CLAUDE_BIN+x}" = x ]; then
    path=$CLAI_CLAUDE_BIN
    case "$path" in /*) ;; *) printf 'CLAI_CLAUDE_BIN must be an absolute executable path\n' >&2; return 127;; esac
  else
    path=$(type -P claude) || { printf 'claude is not on PATH\n' >&2; return 127; }
  fi
  [ -f "$path" ] && [ -x "$path" ] || { printf 'Claude executable is missing or not executable: %s\n' "$path" >&2; return 127; }
  printf '%s/%s\n' "$(cd "$(dirname "$path")" && pwd)" "${path##*/}"
}

claude_bin=$(resolve_claude)

# Claude Code against a local Anthropic-compatible DeepSeek server.
# Existing CLLDS_* overrides remain accepted for the former cllds command.
BASE_URL="${CLDLS_BASE_URL:-${CLLDS_BASE_URL:-}}"
if [[ -z "$BASE_URL" ]]; then
  url_file="${XDG_CONFIG_HOME:-$HOME/.config}/claude-driven-ai-providers/cldls-base-url"
  if [[ -r "$url_file" ]]; then BASE_URL=$(cat "$url_file"); fi
fi
MODEL="${CLDLS_MODEL:-${CLLDS_MODEL:-cyberneurova-fast}}"
CONTEXT_TOKENS="${CLDLS_CONTEXT_TOKENS:-${CLLDS_CONTEXT_TOKENS:-32768}}"

if [[ "${1:-}" == '--help' || "${1:-}" == '-h' ]]; then
  printf 'Usage: cldls [Claude Code arguments]\n\nSelect Fast, Low, Medium, or High in /model, or use --model cyberneurova-low.\nThese aliases control thinking budgets; the generic effort slider is ignored.\n\nUses %s at %s, with a separate ~/.claude-lds profile.\nPermission checks are bypassed, matching the other provider launchers.\n\n' "$MODEL" "$BASE_URL"
  exec "$claude_bin" --help
fi

if [[ -z "$BASE_URL" ]]; then
  printf 'cldls: set CLDLS_BASE_URL or configure the private cldls-base-url file.\n' >&2
  exit 1
fi

if ! curl -fsS --max-time 180 "${BASE_URL%/}/health" >/dev/null; then
  printf 'cldls: CyberNeurova is unavailable at %s.\nCheck the configured local provider server.\n' "$BASE_URL" >&2
  exit 1
fi

export CLAUDE_CONFIG_DIR="$HOME/.claude-lds"
unset ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN
unset CLAUDE_CODE_OAUTH_REFRESH_TOKEN CLAUDE_CODE_OAUTH_SCOPES
unset CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX
unset CLAUDE_CODE_USE_FOUNDRY CLAUDE_CODE_USE_ANTHROPIC_AWS
unset CLAUDE_CODE_EFFORT_LEVEL
export ANTHROPIC_BASE_URL="${BASE_URL%/}"
# Local server does not require authentication; this is a client placeholder.
export ANTHROPIC_AUTH_TOKEN='local-cyberneurova'
if [[ -n "${CLDLS_MODEL:-${CLLDS_MODEL:-}}" ]]; then
  export ANTHROPIC_MODEL="$MODEL"
else
  unset ANTHROPIC_MODEL
fi
export ANTHROPIC_DEFAULT_MODEL='cyberneurova-fast'
export ANTHROPIC_DEFAULT_OPUS_MODEL='cyberneurova-high'
export ANTHROPIC_DEFAULT_FABLE_MODEL='cyberneurova-high'
export ANTHROPIC_DEFAULT_SONNET_MODEL='cyberneurova-medium'
export ANTHROPIC_DEFAULT_HAIKU_MODEL='cyberneurova-fast'
# Effort is controlled by the gateway alias, rather than Claude's effort slider.
export ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES='thinking'
export ANTHROPIC_DEFAULT_FABLE_MODEL_SUPPORTED_CAPABILITIES='thinking'
export ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES='thinking'
export ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES=''
export ANTHROPIC_CUSTOM_MODEL_OPTION='cyberneurova-low'
export ANTHROPIC_CUSTOM_MODEL_OPTION_SUPPORTED_CAPABILITIES='thinking'

export CLAUDE_CODE_SUBAGENT_MODEL='cyberneurova-fast'
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$CONTEXT_TOKENS"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS="${CLDLS_MAX_OUTPUT_TOKENS:-${CLLDS_MAX_OUTPUT_TOKENS:-4096}}"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export API_TIMEOUT_MS="${CLDLS_API_TIMEOUT_MS:-${CLLDS_API_TIMEOUT_MS:-7200000}}"

mkdir -p "$CLAUDE_CONFIG_DIR"
exec "$claude_bin" --dangerously-skip-permissions "$@"
